generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum DealType {
  SALE
  TRADE
  DONATION
  RENTAL
}

enum ListingStatus {
  PENDING
  ACTIVE
  REJECTED
  SOLD
  HIDDEN
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum NegotiationStatus {
  OPEN
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  institution  String
  course       String
  location     String
  role         Role           @default(STUDENT)
  isVerified   Boolean        @default(false)
  isBlocked    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  listings     Listing[]
  favorites    Favorite[]
  sentMessages Message[]
  buyerDeals   Negotiation[]  @relation("BuyerDeals")
  sellerDeals  Negotiation[]  @relation("SellerDeals")
}

model Listing {
  id             String          @id @default(cuid())
  title          String
  description    String
  category       String
  imageUrl       String?
  dealType       DealType
  price          Decimal?        @db.Decimal(10, 2)
  condition      Condition       @default(GOOD)
  location       String
  status         ListingStatus   @default(PENDING)
  rejectionReason String?
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  favorites      Favorite[]
  negotiations   Negotiation[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, category, dealType])
  @@index([ownerId])
}

model Favorite {
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}

model Negotiation {
  id        String            @id @default(cuid())
  listingId String
  buyerId   String
  sellerId  String
  status    NegotiationStatus @default(OPEN)
  listing   Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer     User              @relation("BuyerDeals", fields: [buyerId], references: [id], onDelete: Cascade)
  seller    User              @relation("SellerDeals", fields: [sellerId], references: [id], onDelete: Cascade)
  messages  Message[]
  payment   Payment?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Message {
  id             String      @id @default(cuid())
  content        String
  negotiationId  String
  senderId       String
  negotiation    Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  sender         User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())

  @@index([negotiationId, createdAt])
}

model Payment {
  id              String        @id @default(cuid())
  negotiationId   String        @unique
  negotiation     Negotiation   @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  dealType        DealType
  baseAmount      Decimal       @db.Decimal(10, 2)
  commissionRate  Decimal       @db.Decimal(5, 2)
  platformFee     Decimal       @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  sellerAmount    Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  simulated       Boolean       @default(true)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
