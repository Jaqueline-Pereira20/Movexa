const express = require('express');
const { z } = require('zod');
const prisma = require('../db');
const { requireAuth } = require('../auth');
const { upload } = require('../upload');

const router = express.Router();
router.post('/', requireAuth, async (req, res, next) => {
  try {
    const { listingId, content } = z.object({ listingId: z.string(), content: z.string().trim().min(1).max(2000) }).parse(req.body);
    const listing = await prisma.listing.findUnique({ where: { id: listingId } });
    if (!listing || listing.status !== 'ACTIVE') return res.status(404).json({ error: 'Anúncio não encontrado.' });
    if (listing.ownerId === req.user.sub) return res.status(400).json({ error: 'Você não pode iniciar uma negociação no próprio anúncio.' });
    const negotiation = await prisma.negotiation.create({
      data: { listingId, buyerId: req.user.sub, sellerId: listing.ownerId, messages: { create: { content, senderId: req.user.sub } } },
      include: { messages: true, listing: { select: { id: true, title: true, dealType: true } } }
    });
    res.status(201).json({ negotiation });
  } catch (error) { next(error); }
});

router.get('/mine', requireAuth, async (req, res, next) => {
  try {
    const items = await prisma.negotiation.findMany({
      where: { OR: [{ buyerId: req.user.sub }, { sellerId: req.user.sub }] },
      include: { listing: { select: { id: true, title: true, imageUrl: true, dealType: true, price: true } }, buyer: { select: { id: true, name: true } }, seller: { select: { id: true, name: true } }, messages: { orderBy: { createdAt: 'asc' } }, payment: true, participantPayments: { include: { payer: { select: { id: true, name: true } } } }, deliveries: { include: { sender: { select: { id: true, name: true } }, receiver: { select: { id: true, name: true } } } } },
      orderBy: { updatedAt: 'desc' }
    });
    res.json({ items });
  } catch (error) { next(error); }
});

router.patch('/:id/accept', requireAuth, async (req, res, next) => {
  try {
    const result = await prisma.$transaction(async (tx) => {
      const deal = await tx.negotiation.findUnique({
        where: { id: req.params.id },
        include: { listing: true }
      });

      if (!deal) return { error: 'Negociação não encontrada.', code: 404 };
      if (deal.sellerId !== req.user.sub) return { error: 'Somente o vendedor pode aceitar esta negociação.', code: 403 };
      if (deal.status !== 'OPEN') return { error: 'Esta negociação não está mais aberta.', code: 400 };
      if (deal.listing.status !== 'ACTIVE') return { error: 'Este anúncio não está mais disponível.', code: 400 };

      const now = new Date();
      const deadline = new Date(now);
      deadline.setDate(deadline.getDate() + 5);

      const updated = await tx.negotiation.updateMany({
        where: { id: deal.id, sellerId: req.user.sub, status: 'OPEN' },
        data: { status: 'ACCEPTED', deliveryDeadline: deadline }
      });

      if (updated.count === 0) {
        return { error: 'A negociação já foi alterada. Atualize a página.', code: 409 };
      }

      const deliveries = deal.listing.dealType === 'TRADE'
        ? [
            { negotiationId: deal.id, senderId: deal.sellerId, receiverId: deal.buyerId },
            { negotiationId: deal.id, senderId: deal.buyerId, receiverId: deal.sellerId }
          ]
        : [
            { negotiationId: deal.id, senderId: deal.sellerId, receiverId: deal.buyerId }
          ];

      await tx.delivery.createMany({ data: deliveries });

      return { negotiationId: deal.id };
    });

    if (result.error) return res.status(result.code).json({ error: result.error });

    const negotiation = await prisma.negotiation.findUnique({
      where: { id: result.negotiationId },
      include: {
        listing: { select: { id: true, title: true, imageUrl: true, dealType: true, price: true } },
        buyer: { select: { id: true, name: true } },
        seller: { select: { id: true, name: true } },
        messages: { orderBy: { createdAt: 'asc' } },
        payment: true,
        participantPayments: { include: { payer: { select: { id: true, name: true } } } },
        deliveries: {
          include: {
            sender: { select: { id: true, name: true } },
            receiver: { select: { id: true, name: true } }
          }
        }
      }
    });

    res.json({
      negotiation,
      message: 'Negociação aceita. O prazo inicial para entrega é de 5 dias.'
    });
  } catch (error) {
    next(error);
  }
});router.post('/:id/payment/simulate', requireAuth, async (req, res, next) => {
  try {
    const { status, method } = z.object({
      status: z.enum(['APPROVED', 'DECLINED']),
      method: z.enum(['PIX', 'CARD'])
    }).parse(req.body);

    const result = await prisma.$transaction(async (tx) => {
      const deal = await tx.negotiation.findUnique({
        where: { id: req.params.id },
        include: { listing: true }
      });

      if (!deal) return { error: 'Negociação não encontrada.', code: 404 };
      if (![deal.buyerId, deal.sellerId].includes(req.user.sub)) {
        return { error: 'Esta negociação não pertence à sua conta.', code: 403 };
      }
      if (deal.status !== 'ACCEPTED') {
        return { error: 'A negociação precisa estar aceita para realizar o pagamento.', code: 400 };
      }

      const type = deal.listing.dealType;
      let amountCents;

      if (type === 'TRADE') {
        amountCents = 390;
      } else if (['SALE', 'RENTAL'].includes(type)) {
        if (deal.buyerId !== req.user.sub) {
          return { error: 'Somente o comprador ou locatário realiza este pagamento.', code: 403 };
        }
        if (deal.listing.price === null || Number(deal.listing.price) <= 0) {
          return { error: 'O anúncio não possui um preço válido para pagamento.', code: 400 };
        }
        const baseCents = Math.round(Number(deal.listing.price) * 100);
        amountCents = baseCents + Math.round(baseCents * 0.12);
      } else {
        return { error: 'Doações não possuem cobrança.', code: 400 };
      }

      const existing = await tx.participantPayment.findUnique({
        where: {
          negotiationId_payerId: {
            negotiationId: deal.id,
            payerId: req.user.sub
          }
        }
      });

      if (existing?.status === 'APPROVED') {
        return { error: 'Seu pagamento já foi aprovado.', code: 409 };
      }

      const money = (cents) => (cents / 100).toFixed(2);

      const participantPayment = await tx.participantPayment.upsert({
        where: {
          negotiationId_payerId: {
            negotiationId: deal.id,
            payerId: req.user.sub
          }
        },
        create: {
          negotiationId: deal.id,
          payerId: req.user.sub,
          amount: money(amountCents),
          method,
          status,
          simulated: true,
          paidAt: status === 'APPROVED' ? new Date() : null
        },
        update: {
          amount: money(amountCents),
          method,
          status,
          simulated: true,
          paidAt: status === 'APPROVED' ? new Date() : null
        }
      });

      let payment = null;

      if (['SALE', 'RENTAL'].includes(type)) {
        const baseCents = Math.round(Number(deal.listing.price) * 100);
        const feeCents = amountCents - baseCents;

        payment = await tx.payment.upsert({
          where: { negotiationId: deal.id },
          create: {
            negotiationId: deal.id,
            dealType: type,
            baseAmount: money(baseCents),
            commissionRate: '12.00',
            platformFee: money(feeCents),
            totalAmount: money(amountCents),
            sellerAmount: money(baseCents),
            status,
            simulated: true,
            paidAt: status === 'APPROVED' ? new Date() : null
          },
          update: {
            baseAmount: money(baseCents),
            commissionRate: '12.00',
            platformFee: money(feeCents),
            totalAmount: money(amountCents),
            sellerAmount: money(baseCents),
            status,
            simulated: true,
            paidAt: status === 'APPROVED' ? new Date() : null
          }
        });
      }

      return { participantPayment, payment };
    });

    if (result.error) return res.status(result.code).json({ error: result.error });

    res.json({
      participantPayment: result.participantPayment,
      payment: result.payment,
      negotiationStatus: 'ACCEPTED',
      message: status === 'APPROVED'
        ? 'Pagamento simulado aprovado. A negociação continua em andamento até a confirmação da entrega. Nenhum dinheiro real foi movimentado.'
        : 'Pagamento simulado recusado. Nenhum dinheiro real foi movimentado.'
    });
  } catch (error) {
    next(error);
  }
});
router.post('/:id/messages', requireAuth, async (req, res, next) => {
  try {
    const { content } = z.object({ content: z.string().trim().min(1).max(2000) }).parse(req.body);
    const deal = await prisma.negotiation.findUnique({ where: { id: req.params.id } });
    if (!deal) return res.status(404).json({ error: 'Negociação não encontrada.' });
    if (![deal.buyerId, deal.sellerId].includes(req.user.sub)) return res.status(403).json({ error: 'Esta conversa não pertence à sua conta.' });
    if (deal.status === 'CANCELLED' || deal.status === 'COMPLETED') return res.status(400).json({ error: 'Esta negociação foi encerrada.' });
    const message = await prisma.message.create({ data: { content, negotiationId: deal.id, senderId: req.user.sub } });
    await prisma.negotiation.update({ where: { id: deal.id }, data: { updatedAt: new Date() } });
    res.status(201).json({ message });
  } catch (error) { next(error); }
});

router.post('/:id/deliveries/:deliveryId/proof', requireAuth, upload.single('image'), async (req, res, next) => {
  try {
    if (!req.file) return res.status(400).json({ error: 'Envie uma foto para comprovar a entrega.' });

    const result = await prisma.$transaction(async (tx) => {
      const deal = await tx.negotiation.findUnique({
        where: { id: req.params.id },
        include: { listing: true, participantPayments: true }
      });

      if (!deal) return { error: 'Negociação não encontrada.', code: 404 };
      if (deal.status !== 'ACCEPTED') return { error: 'Esta negociação não está em andamento.', code: 400 };

      const delivery = await tx.delivery.findFirst({
        where: { id: req.params.deliveryId, negotiationId: deal.id }
      });

      if (!delivery) return { error: 'Entrega não encontrada.', code: 404 };
      if (delivery.senderId !== req.user.sub) return { error: 'Somente o responsável por esta entrega pode enviar a foto.', code: 403 };
      if (delivery.confirmedAt) return { error: 'Esta entrega já foi confirmada.', code: 400 };

      const type = deal.listing.dealType;
      const requiredPayers = type === 'TRADE'
        ? [deal.buyerId, deal.sellerId]
        : ['SALE', 'RENTAL'].includes(type)
          ? [deal.buyerId]
          : [];

      const paymentsApproved = requiredPayers.every((payerId) =>
        deal.participantPayments.some((payment) =>
          payment.payerId === payerId && payment.status === 'APPROVED'
        )
      );

      if (!paymentsApproved) {
        return { error: 'Os pagamentos obrigatórios precisam ser aprovados antes do envio da comprovação.', code: 400 };
      }

      const updated = await tx.delivery.updateMany({
        where: { id: delivery.id, senderId: req.user.sub, confirmedAt: null },
        data: {
          proofImageUrl: `/uploads/${req.file.filename}`,
          sentAt: new Date()
        }
      });

      if (updated.count === 0) return { error: 'A comprovação já foi alterada. Atualize a página.', code: 409 };

      return { deliveryId: delivery.id };
    });

    if (result.error) return res.status(result.code).json({ error: result.error });

    const delivery = await prisma.delivery.findUnique({
      where: { id: result.deliveryId },
      include: {
        sender: { select: { id: true, name: true } },
        receiver: { select: { id: true, name: true } }
      }
    });

    res.json({ delivery, message: 'Foto de comprovação enviada com sucesso.' });
  } catch (error) {
    next(error);
  }
});

router.post('/:id/deliveries/:deliveryId/confirm', requireAuth, async (req, res, next) => {
  try {
    const result = await prisma.$transaction(async (tx) => {
      const deal = await tx.negotiation.findUnique({
        where: { id: req.params.id },
        include: { listing: true, participantPayments: true }
      });

      if (!deal) return { error: 'Negociação não encontrada.', code: 404 };
      if (deal.status !== 'ACCEPTED') return { error: 'Esta negociação não está em andamento.', code: 400 };

      const delivery = await tx.delivery.findFirst({
        where: { id: req.params.deliveryId, negotiationId: deal.id }
      });

      if (!delivery) return { error: 'Entrega não encontrada.', code: 404 };
      if (delivery.receiverId !== req.user.sub) return { error: 'Somente quem recebe pode confirmar esta entrega.', code: 403 };
      if (!delivery.proofImageUrl) return { error: 'Aguarde o envio da foto de comprovação.', code: 400 };
      if (delivery.confirmedAt) return { error: 'Esta entrega já foi confirmada.', code: 409 };

      await tx.delivery.update({
        where: { id: delivery.id },
        data: { confirmedAt: new Date() }
      });

      const deliveries = await tx.delivery.findMany({
        where: { negotiationId: deal.id }
      });

      const allDeliveriesConfirmed = deliveries.length > 0 &&
        deliveries.every((item) => item.confirmedAt !== null || item.id === delivery.id);

      const type = deal.listing.dealType;
      const requiredPayers = type === 'TRADE'
        ? [deal.buyerId, deal.sellerId]
        : ['SALE', 'RENTAL'].includes(type)
          ? [deal.buyerId]
          : [];

      const allPaymentsApproved = requiredPayers.every((payerId) =>
        deal.participantPayments.some((payment) =>
          payment.payerId === payerId && payment.status === 'APPROVED'
        )
      );

      let completed = false;

      if (allDeliveriesConfirmed && allPaymentsApproved) {
        const updatedDeal = await tx.negotiation.updateMany({
          where: { id: deal.id, status: 'ACCEPTED' },
          data: { status: 'COMPLETED' }
        });

        if (updatedDeal.count === 1) {
          completed = true;

          if (type === 'SALE' || type === 'TRADE') {
            await tx.listing.updateMany({
              where: { id: deal.listingId, status: 'ACTIVE' },
              data: { status: 'SOLD' }
            });
          }
        }
      }

      return { completed, deliveryId: delivery.id };
    });

    if (result.error) return res.status(result.code).json({ error: result.error });

    const delivery = await prisma.delivery.findUnique({
      where: { id: result.deliveryId },
      include: {
        sender: { select: { id: true, name: true } },
        receiver: { select: { id: true, name: true } }
      }
    });

    res.json({
      delivery,
      negotiationStatus: result.completed ? 'COMPLETED' : 'ACCEPTED',
      message: result.completed
        ? 'Todas as etapas foram concluídas. Negociação finalizada com sucesso!'
        : 'Recebimento confirmado. Aguardando as demais etapas da negociação.'
    });
  } catch (error) {
    next(error);
  }
});

module.exports = router;





