import { useEffect, useMemo, useState } from 'react';
import { ArrowRight, BookOpen, Calculator, ChevronDown, Heart, Laptop, LibraryBig, Menu, Search, ShieldCheck, SlidersHorizontal, Sparkles, X } from 'lucide-react';

const API = import.meta.env.VITE_API_URL || '/api';
const imageSrc = (url) => url?.startsWith('/uploads/')
  ? `${API.replace(/\/api\/?$/, '')}${url}`
  : url;
const categories = [
  { name: 'Livros', icon: BookOpen, color: 'lavender' },
  { name: 'Tecnologia', icon: Laptop, color: 'peach' },
  { name: 'Papelaria', icon: LibraryBig, color: 'mint' },
  { name: 'Equipamentos', icon: Calculator, color: 'blue' }
];
const examples = [
  { id: 'demo-1', title: 'Cálculo — James Stewart, 8ª edição', category: 'Livros', dealType: 'SALE', price: 85, condition: 'GOOD', location: 'São Paulo, SP', imageUrl: 'https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&fit=crop&w=800&q=80', owner: { name: 'Marina Costa', course: 'Engenharia Civil' } },
  { id: 'demo-2', title: 'Calculadora científica Casio FX-82', category: 'Equipamentos', dealType: 'RENTAL', price: 12, condition: 'LIKE_NEW', location: 'Campinas, SP', imageUrl: 'https://images.unsplash.com/photo-1587145820266-a5951ee6f620?auto=format&fit=crop&w=800&q=80', owner: { name: 'Lucas Ferreira', course: 'Matemática' } },
  { id: 'demo-3', title: 'Kit de desenho técnico completo', category: 'Papelaria', dealType: 'DONATION', price: null, condition: 'GOOD', location: 'Santos, SP', imageUrl: 'https://images.unsplash.com/photo-1513364776144-60967b0f800f?auto=format&fit=crop&w=800&q=80', owner: { name: 'Ana Clara', course: 'Arquitetura' } },
  { id: 'demo-4', title: 'Introdução à programação com Python', category: 'Livros', dealType: 'TRADE', price: null, condition: 'LIKE_NEW', location: 'São Paulo, SP', imageUrl: 'https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=800&q=80', owner: { name: 'Rafael Lima', course: 'Sistemas de Informação' } }
];
const dealLabels = { SALE: 'À venda', TRADE: 'Troca', DONATION: 'Doação', RENTAL: 'Aluguel' };
const conditionLabels = { NEW: 'Novo', LIKE_NEW: 'Quase novo', GOOD: 'Bom estado', FAIR: 'Usado' };
const money = (value) => value == null ? null : Number(value).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

export default function App() {
  const [listings, setListings] = useState(examples);
  const [search, setSearch] = useState('');
  const [category, setCategory] = useState('');
  const [dealType, setDealType] = useState('');
  const [loading, setLoading] = useState(false);
  const [notice, setNotice] = useState('');
  const [modal, setModal] = useState('');
  const [imagePreview, setImagePreview] = useState('');
  const [selectedListing, setSelectedListing] = useState(null);
  const [user, setUser] = useState(() => { try { return JSON.parse(localStorage.getItem('movexa-user')); } catch { return null; } });
  const [token, setToken] = useState(() => localStorage.getItem('movexa-token') || '');
  const [favorites, setFavorites] = useState([]);
  const [mobileMenu, setMobileMenu] = useState(false);
  const [activeView, setActiveView] = useState('home');
    const [negotiations, setNegotiations] = useState([]);
  const [selectedNegotiation, setSelectedNegotiation] = useState(null);
  const [activeNegotiationTab, setActiveNegotiationTab] = useState('conversation');
  const [paymentMethod, setPaymentMethod] = useState('PIX');
  const [messageDraft, setMessageDraft] = useState('');
  const [loadingNegotiations, setLoadingNegotiations] = useState(false);
  const [pendingListings, setPendingListings] = useState([]);
  const [loadingPending, setLoadingPending] = useState(false);
  const [pendingPayments, setPendingPayments] = useState([]);
  const [loadingPayments, setLoadingPayments] = useState(false);
  const [reviewingPayment, setReviewingPayment] = useState('');
  const [myListings, setMyListings] = useState([]);
  const [loadingMyListings, setLoadingMyListings] = useState(false);
  const [myListingsFilter, setMyListingsFilter] = useState('ALL');
  const [moderatingListing, setModeratingListing] = useState('');
  const [rejectionListingId, setRejectionListingId] = useState('');
  const [rejectionReason, setRejectionReason] = useState('');
  const [profileForm, setProfileForm] = useState({
    name: '',
    institution: '',
    course: '',
    location: ''
  });
  const [savingProfile, setSavingProfile] = useState(false);

  const query = useMemo(() => new URLSearchParams(Object.fromEntries(Object.entries({ q: search, category, dealType }).filter(([, value]) => value))), [search, category, dealType]);
  useEffect(() => {
    let active = true;
    setLoading(true);
    fetch(`${API}/listings?${query}`).then(async (response) => {
      if (!response.ok) throw new Error('Não foi possível carregar os anúncios.');
      return response.json();
    }).then((data) => { if (active && data.items.length) setListings(data.items); else if (active) setListings(search || category || dealType ? [] : examples); })
      .catch(() => { if (active) setListings(examples.filter((item) => (!search || item.title.toLowerCase().includes(search.toLowerCase())) && (!category || item.category === category) && (!dealType || item.dealType === dealType))); })
      .finally(() => { if (active) setLoading(false); });
    return () => { active = false; };
  }, [query, search, category, dealType]);
    useEffect(() => {
    if (!user || !token) {
      setNegotiations([]);
      setSelectedNegotiation(null);
      return;
    }

    let active = true;
    setLoadingNegotiations(true);

    fetch(`${API}/negotiations/mine`, {
      headers: {
        Authorization: `Bearer ${token}`
      }
    })
      .then(async (response) => {
        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'Não foi possível carregar as negociações.');
        }

        return data;
      })
      .then((data) => {
        if (active) {
          setNegotiations(data.items || []);
        }
      })
      .catch((error) => {
        if (active) {
          setNotice(error.message);
        }
      })
      .finally(() => {
        if (active) {
          setLoadingNegotiations(false);
        }
      });

    return () => {
      active = false;
    };
  }, [user, token]);

  useEffect(() => {
    if (!user || !token || user.role !== 'ADMIN') {
      setPendingListings([]);
      return;
    }

    let active = true;
    setLoadingPending(true);

    fetch(`${API}/listings/admin/pending`, {
      headers: {
        Authorization: `Bearer ${token}`
      }
    })
      .then(async (response) => {
        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'Não foi possível carregar os anúncios pendentes.');
        }

        return data;
      })
      .then((data) => {
        if (active) setPendingListings(data.items || []);
      })
      .catch((error) => {
        if (active) setNotice(error.message);
      })
      .finally(() => {
        if (active) setLoadingPending(false);
      });

    return () => {
      active = false;
    };
  }, [user, token]);
  useEffect(() => {
    if (!user || !token || user.role !== 'ADMIN') {
      setPendingPayments([]);
      setLoadingPayments(false);
      return;
    }

    let active = true;
    setLoadingPayments(true);

    fetch(`${API}/negotiations/admin/payments`, {
      headers: {
        Authorization: `Bearer ${token}`
      }
    })
      .then(async (response) => {
        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'Não foi possível carregar os pagamentos pendentes.');
        }

        return data;
      })
      .then((data) => {
        if (active) setPendingPayments(data.items || []);
      })
      .catch((error) => {
        if (active) setNotice(error.message);
      })
      .finally(() => {
        if (active) setLoadingPayments(false);
      });

    return () => {
      active = false;
    };
  }, [user, token]);
  useEffect(() => {
    if (!user || !token || user.role === 'ADMIN') {
      setMyListings([]);
      return;
    }

    let active = true;
    setLoadingMyListings(true);

    fetch(API + '/listings/mine', {
      headers: {
        Authorization: 'Bearer ' + token
      }
    })
      .then(async (response) => {
        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.error || 'Não foi possível carregar seus produtos.');
        }
        return data;
      })
      .then((data) => {
        if (active) setMyListings(data.items || []);
      })
      .catch((error) => {
        if (active) setNotice(error.message);
      })
      .finally(() => {
        if (active) setLoadingMyListings(false);
      });

    return () => {
      active = false;
    };
  }, [user, token]);

  async function moderateListing(id, status, reason = '') {
    setModeratingListing(id);

    try {
      const response = await fetch(`${API}/listings/admin/${id}/moderate`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify({
          status,
          ...(status === 'REJECTED' ? { rejectionReason: reason } : {})
        })
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Não foi possível atualizar o anúncio.');
      }

      setPendingListings((current) => current.filter((item) => item.id !== id));
      setRejectionListingId('');
      setRejectionReason('');
      setNotice(status === 'ACTIVE'
        ? 'Anúncio aprovado e publicado!'
        : 'Anúncio rejeitado. O estudante poderá consultar o motivo em Meus produtos.');
    } catch (error) {
      setNotice(error.message);
    } finally {
      setModeratingListing('');
    }
  }
  async function submitAuth(event) {
    event.preventDefault();
    const form = Object.fromEntries(new FormData(event.currentTarget));
    const mode = modal;
    try {
      const response = await fetch(`${API}/auth/${mode}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(form) });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Não foi possível entrar.');
      localStorage.setItem('movexa-token', data.token); localStorage.setItem('movexa-user', JSON.stringify(data.user)); setToken(data.token); setUser(data.user); setModal(''); setNotice(`Que bom ter você aqui, ${data.user.name.split(' ')[0]}!`);
    } catch (error) { setNotice(error.message); }
  }

  async function saveProfile(event) {
    event.preventDefault();
    setSavingProfile(true);

    try {
      const response = await fetch(`${API}/auth/me`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify(profileForm)
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Não foi possível atualizar o perfil.');
      }

      localStorage.setItem('movexa-user', JSON.stringify(data.user));
      setUser(data.user);
      setNotice('Perfil atualizado com sucesso!');
      setActiveView('home');
    } catch (error) {
      setNotice(error.message);
    } finally {
      setSavingProfile(false);
    }
  }
  async function createListing(event) {
    event.preventDefault();
    const formData = new FormData(event.currentTarget);
    try {
      const response = await fetch(`${API}/listings`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
        body: formData
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Não foi possível publicar.');
      setNotice('Anúncio enviado! Ele ficará visível após a aprovação da equipe.');
      setModal('');
    } catch (error) {
      setNotice(error.message);
    }
  }

  function openListing(item) {
    setSelectedListing(item);
    setModal('details');
  }
  async function startNegotiation() {
  if (!user || !token) {
    setModal('login');
    setNotice('Entre na sua conta para iniciar uma negociação.');
    return;
  }

  if (!selectedListing || selectedListing.id.startsWith('demo-')) {
    setNotice('Este é um anúncio demonstrativo. Escolha um anúncio publicado na plataforma.');
    return;
  }

  const content = `Olá! Tenho interesse no material "${selectedListing.title}". Gostaria de conversar sobre ele.`;

  try {
    const response = await fetch(`${API}/negotiations`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${token}`
      },
      body: JSON.stringify({
        listingId: selectedListing.id,
        content
      })
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || 'Não foi possível iniciar a negociação.');
    }

    setModal('');
    setNotice('Negociação iniciada com sucesso! A primeira mensagem foi enviada.');
  } catch (error) {
    setNotice(error.message);
  }
}
  async function sendMessage(event) {
    event.preventDefault();

    const content = messageDraft.trim();

    if (!content || !selectedNegotiation) return;

    try {
      const response = await fetch(
        `${API}/negotiations/${selectedNegotiation.id}/messages`,
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${token}`
          },
          body: JSON.stringify({ content })
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Não foi possível enviar a mensagem.');
      }

      setNegotiations((current) =>
        current.map((item) =>
          item.id === selectedNegotiation.id
            ? { ...item, messages: [...item.messages, data.message] }
            : item
        )
      );

      setSelectedNegotiation((current) => ({
        ...current,
        messages: [...current.messages, data.message]
      }));

      setMessageDraft('');
      setNotice('Mensagem enviada com sucesso!');
    } catch (error) {
      setNotice(error.message);
    }
  }
  async function acceptNegotiation() {
    if (!selectedNegotiation) return;

    try {
      const response = await fetch(
        `${API}/negotiations/${selectedNegotiation.id}/accept`,
        {
          method: 'PATCH',
          headers: {
            Authorization: `Bearer ${token}`
          }
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Não foi possível aceitar a negociação.');
      }

      setNegotiations((current) =>
        current.map((item) =>
          item.id === data.negotiation.id ? data.negotiation : item
        )
      );

      setSelectedNegotiation(data.negotiation);
      setActiveNegotiationTab('payment');
      setNotice('Negociação aceita! Já é possível realizar o pagamento.');
    } catch (error) {
      setNotice(error.message);
    }
  }
  async function reportPayment(method) {
    if (!selectedNegotiation) return;

    try {
      const response = await fetch(
        `${API}/negotiations/${selectedNegotiation.id}/payment/simulate`,
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${token}`
          },
          body: JSON.stringify({ method })
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Não foi possível informar o pagamento.');
      }

      const updatedNegotiation = {
        ...selectedNegotiation,
        participantPayments: [
          ...(selectedNegotiation.participantPayments || []).filter(
            (item) => item.payerId !== data.participantPayment.payerId
          ),
          data.participantPayment
        ]
      };

      setSelectedNegotiation(updatedNegotiation);
      setNegotiations((current) =>
        current.map((item) =>
          item.id === updatedNegotiation.id ? updatedNegotiation : item
        )
      );

      setNotice(data.message || 'Pagamento informado. Aguarde a análise da administração.');
    } catch (error) {
      setNotice(error.message);
    }
  }
  async function decideParticipantPayment(paymentId, status) {
    setReviewingPayment(paymentId);

    try {
      const response = await fetch(
        `${API}/negotiations/admin/payments/${paymentId}/decision`,
        {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${token}`
          },
          body: JSON.stringify({ status })
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Não foi possível analisar o pagamento.');
      }

      setPendingPayments((current) =>
        current.filter((item) => item.id !== paymentId)
      );

      setNotice(data.message);
    } catch (error) {
      setNotice(error.message);
    } finally {
      setReviewingPayment('');
    }
  }
  function updateSelectedNegotiation(updatedNegotiation) {
    setSelectedNegotiation(updatedNegotiation);
    setNegotiations((current) =>
      current.map((item) =>
        item.id === updatedNegotiation.id ? updatedNegotiation : item
      )
    );
  }

  async function uploadDeliveryProof(deliveryId, file) {
    if (!selectedNegotiation || !file) return;

    try {
      const formData = new FormData();
      formData.append('image', file);

      const response = await fetch(
        `${API}/negotiations/${selectedNegotiation.id}/deliveries/${deliveryId}/proof`,
        {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}` },
          body: formData
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Não foi possível enviar a comprovação.');
      }

      const updatedNegotiation = {
        ...selectedNegotiation,
        deliveries: (selectedNegotiation.deliveries || []).map((item) =>
          item.id === data.delivery.id ? data.delivery : item
        )
      };

      updateSelectedNegotiation(updatedNegotiation);
      setNotice(data.message);
    } catch (error) {
      setNotice(error.message);
    }
  }

  async function confirmDelivery(deliveryId) {
    if (!selectedNegotiation) return;

    try {
      const response = await fetch(
        `${API}/negotiations/${selectedNegotiation.id}/deliveries/${deliveryId}/confirm`,
        {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}` }
        }
      );

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Não foi possível confirmar o recebimento.');
      }

      const updatedNegotiation = {
        ...selectedNegotiation,
        status: data.negotiationStatus,
        deliveries: (selectedNegotiation.deliveries || []).map((item) =>
          item.id === data.delivery.id ? data.delivery : item
        )
      };

      updateSelectedNegotiation(updatedNegotiation);
      setNotice(data.message);
    } catch (error) {
      setNotice(error.message);
    }
  }
  function logout() { localStorage.removeItem('movexa-token'); localStorage.removeItem('movexa-user'); setToken(''); setUser(null); }
  const filtered = listings;

  return <>
    <header className="topbar"><div className="nav-wrap">
      <a className="brand" href="#inicio" aria-label="Movexa início"><span className="brand-mark">m</span><span>movexa<span className="brand-dot">.</span></span></a>
      <button className="mobile-toggle" onClick={() => setMobileMenu(!mobileMenu)} aria-label="Abrir menu">{mobileMenu ? <X /> : <Menu />}</button>
      <nav className={mobileMenu ? 'nav-links open' : 'nav-links'}><a href="#explorar" onClick={() => setMobileMenu(false)}>Explorar</a><a href="#categorias" onClick={() => setMobileMenu(false)}>Categorias</a><a href="#como-funciona" onClick={() => { setActiveView('home'); setMobileMenu(false); }}>Como funciona</a>{user && <><button className="nav-view-button" onClick={() => { setProfileForm({ name: user.name || '', institution: user.institution || '', course: user.course || '', location: user.location || '' }); setActiveView('profile'); setMobileMenu(false); }}>Meu perfil</button>{user?.role !== 'ADMIN' && <button className="nav-view-button" onClick={() => { setActiveView('my-listings'); setMobileMenu(false); }}>Meus produtos</button>}<button className="nav-view-button" onClick={() => { setActiveView('negotiations'); setMobileMenu(false); }}>Minhas negociações</button></>}{user?.role === 'ADMIN' && <button className="nav-view-button" onClick={() => { setActiveView('admin'); setMobileMenu(false); }}>Painel administrativo</button>}</nav>
      <div className="nav-actions">{user ? <><span className="welcome">Oi, {user.name.split(' ')[0]}</span><button className="btn btn-outline" onClick={logout}>Sair</button></> : <><button className="login-link" onClick={() => setModal('login')}>Entrar</button><button className="btn btn-dark" onClick={() => setModal('register')}>Criar conta <ArrowRight size={16} /></button></>}<button className="btn btn-orange nav-publish" onClick={() => user ? setModal('listing') : setModal('login')}>Anunciar grátis <span>＋</span></button></div>
    </div></header>

    {activeView === 'home' ? (<><main id="inicio"><section className="hero"><div className="hero-grid"><div className="hero-copy"><div className="eyebrow"><Sparkles size={14} /> O marketplace feito por estudantes</div><h1>Seu próximo capítulo começa <em>por aqui.</em></h1><p>Encontre o que precisa para estudar. Dê uma nova vida ao que já aprendeu. Tudo em uma comunidade só sua.</p><div className="hero-ctas"><a className="btn btn-orange btn-large" href="#explorar">Explorar materiais <ArrowRight size={17} /></a><button className="text-action" onClick={() => user ? setModal('listing') : setModal('register')}>Quero anunciar <span>↗</span></button></div><div className="social-proof"><div className="avatar-stack"><span>J</span><span>M</span><span>A</span><span>+</span></div><span><b>Feito para estudantes.</b><br />Compartilhado entre eles.</span></div></div><div className="hero-art"><div className="hero-orbit orbit-one"></div><div className="hero-orbit orbit-two"></div><div className="hero-book"><BookOpen size={96} strokeWidth={1.1} /><span>novas ideias,<br />novas possibilidades</span></div><div className="floating-card float-card-one"><span className="float-icon">↗</span><span><b>Conhecimento circula</b><small>e todo mundo cresce</small></span></div><div className="floating-card float-card-two"><span className="float-avatar">✦</span><span><b>Uma comunidade</b><small>que entende você</small></span></div><span className="sparkle sparkle-a">✳</span><span className="sparkle sparkle-b">✦</span></div></div><div className="hero-bottom"><span>MAIS ACESSO. MENOS DESPERDÍCIO.</span><span className="hero-line"></span><span>CONHECIMENTO EM MOVIMENTO <span className="orange">✳</span></span></div></section>

    <section className="search-section" id="explorar"><div className="section-heading"><div><span className="eyebrow">COMECE A DESCOBRIR</span><h2>O que você está <em>procurando?</em></h2></div><span className="result-note">Materiais que ajudam você a ir mais longe.</span></div><div className="search-panel"><Search size={20} /><input value={search} onChange={(e) => setSearch(e.target.value)} placeholder="Busque livros, calculadoras, materiais..." aria-label="Buscar materiais" /><button className="btn btn-orange search-button" onClick={() => document.getElementById('catalog-grid')?.scrollIntoView({ behavior: 'smooth' })}>Buscar <ArrowRight size={16} /></button><button className="filter-button" onClick={() => document.getElementById('deal-filter')?.focus()} aria-label="Filtros"><SlidersHorizontal size={19} /></button></div>
      <div className="category-row" id="categorias"><button className={!category ? 'category-chip selected' : 'category-chip'} onClick={() => setCategory('')}>Tudo</button>{categories.map(({ name, icon: Icon, color }) => <button key={name} className={category === name ? 'category-chip selected' : 'category-chip'} onClick={() => setCategory(category === name ? '' : name)}><span className={`category-icon ${color}`}><Icon size={16} /></span>{name}</button>)}<label className="deal-select"><select id="deal-filter" value={dealType} onChange={(e) => setDealType(e.target.value)}><option value="">Modalidade</option><option value="SALE">Venda</option><option value="TRADE">Troca</option><option value="DONATION">Doação</option><option value="RENTAL">Aluguel</option></select><ChevronDown size={15} /></label></div>
      <div className="catalog-heading"><div><span className="eyebrow">SELECIONADOS PARA VOCÊ</span><h2>Encontre seu <em>próximo achado.</em></h2></div><a href="#explorar" className="view-all">Ver todos <ArrowRight size={16} /></a></div>
      {loading && <p className="status-message">Carregando materiais...</p>}
      <div className="catalog-grid" id="catalog-grid">{filtered.map((item) => <article className="product-card" key={item.id}><div className="product-image"><img src={imageSrc(item.imageUrl) || 'https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?auto=format&fit=crop&w=800&q=80'} alt={item.title} /><span className="deal-badge">{dealLabels[item.dealType] || item.dealType}</span><button className={favorites.includes(item.id) ? 'heart-button active' : 'heart-button'} onClick={() => setFavorites(favorites.includes(item.id) ? favorites.filter((id) => id !== item.id) : [...favorites, item.id])} aria-label="Favoritar anúncio"><Heart size={18} fill={favorites.includes(item.id) ? 'currentColor' : 'none'} /></button></div><div className="product-info"><span className="product-category">{item.category}</span><h3>{item.title}</h3><div className="product-meta"><span>{conditionLabels[item.condition] || 'Bom estado'}</span><span>·</span><span>{item.location}</span></div><div className="product-bottom"><div className="product-price">{money(item.price) || <span className="no-price">A combinar</span>}{item.dealType === 'RENTAL' && item.price != null && <small>/ período</small>}</div><button className="card-arrow" onClick={() => openListing(item)} aria-label="Ver anúncio"><ArrowRight size={18} /></button></div></div></article>)}{!loading && !filtered.length && <div className="empty-state"><BookOpen size={32} /><h3>Nenhum material encontrado</h3><p>Tente mudar a busca ou os filtros.</p></div>}</div>
    </section>

    <section className="mission" id="como-funciona"><div className="mission-inner"><div className="mission-badge"><ShieldCheck size={18} /> UM CICLO QUE FAZ SENTIDO</div><div className="mission-content"><h2>O que já ajudou alguém<br />pode ajudar <em>você também.</em></h2><p>A Movexa aproxima estudantes e faz materiais acadêmicos circularem. Mais acesso para quem precisa, mais propósito para o que ficaria parado.</p><button className="btn btn-orange" onClick={() => user ? setModal('listing') : setModal('register')}>Faça parte da comunidade <ArrowRight size={16} /></button></div><div className="mission-stat"><span>↗</span><b>Aprender<br />compartilhando.</b><small>Uma troca de valor, em todos os sentidos.</small></div></div></section>
    <section className="steps"><div className="section-heading"><div><span className="eyebrow">SIMPLES ASSIM</span><h2>Três passos. <em>Uma comunidade.</em></h2></div></div><div className="step-grid"><div className="step-card"><span>01</span><h3>Encontre</h3><p>Busque materiais de outros estudantes para sua próxima etapa.</p></div><div className="step-card"><span>02</span><h3>Converse</h3><p>Combine diretamente com quem está anunciando.</p></div><div className="step-card"><span>03</span><h3>Movimente</h3><p>Compre, troque, alugue ou doe. E passe o conhecimento adiante.</p></div></div></section>
    </main>

    <footer><div className="footer-main"><a className="brand footer-brand" href="#inicio"><span className="brand-mark">m</span><span>movexa<span className="brand-dot">.</span></span></a><p>Conhecimento em movimento.<br />Feito para quem está aprendendo.</p><div className="footer-links"><a href="#explorar">Explorar materiais</a><a href="#como-funciona">Como funciona</a><a href="mailto:oi@movexa.com.br">Fale com a gente</a></div></div><div className="footer-bottom"><span>© 2026 Movexa. Feito para estudantes, com propósito.</span><span>Mais acesso. Menos desperdício. <span className="orange">✳</span></span></div></footer>
    </>) : activeView === 'negotiations' ? (
      <main className="negotiations-page">
        <section className="negotiations-container">
          <div className="negotiations-heading">
            <div>
              <span className="eyebrow">SUA COMUNIDADE</span>
              <h1>Minhas <em>negociações</em></h1>
              <p>Acompanhe suas conversas e combine os detalhes diretamente com outros estudantes.</p>
            </div>
            <button className="btn btn-outline" onClick={() => { setActiveView('home'); setSelectedNegotiation(null); }}>Voltar aos anúncios</button>
          </div>

          <div className="negotiations-layout">
            <aside className="negotiations-list">
              <h2>Conversas</h2>
              {loadingNegotiations ? <p>Carregando conversas...</p> :
                negotiations.length === 0 ? <p>Você ainda não possui negociações.</p> :
                negotiations.map((item) => {
                  const otherPerson = item.buyerId === user.id ? item.seller : item.buyer;
                  return (
                    <button key={item.id} className={`negotiation-item ${selectedNegotiation?.id === item.id ? 'selected' : ''}`} onClick={() => setSelectedNegotiation(item)}>
                      <strong>{otherPerson?.name || 'Estudante'}</strong>
                      <span>{item.listing?.title || 'Anúncio'}</span>
                      <small>{item.messages?.length || 0} mensagem(ns)</small>
                    </button>
                  );
                })
              }
            </aside>

            <section className="negotiation-chat">
              {selectedNegotiation ? (
                <>
                  <div className="negotiation-chat-header">
                    <div>
                      <h2>{selectedNegotiation.listing?.title || 'Negociação'}</h2>
                      <p>Com {((selectedNegotiation.buyerId === user.id ? selectedNegotiation.seller : selectedNegotiation.buyer)?.name) || 'Estudante'}</p>
                    </div>
                    <span>{selectedNegotiation.status || 'Em andamento'}</span>
                  </div>
                  {selectedNegotiation.sellerId === user.id && selectedNegotiation.status === 'OPEN' && (
                    <div className="negotiation-actions">
                      <button className="btn btn-orange" type="button" onClick={acceptNegotiation}>
                        Aceitar negociação
                      </button>
                    </div>
                  )}

                  {['ACCEPTED', 'COMPLETED'].includes(selectedNegotiation.status) && (
                    <div className="negotiation-tabs">
                      <button
                        type="button"
                        className={activeNegotiationTab === 'conversation' ? 'active' : ''}
                        onClick={() => setActiveNegotiationTab('conversation')}
                      >
                        Conversa
                      </button>
                      <button
                        type="button"
                        className={activeNegotiationTab === 'payment' ? 'active' : ''}
                        onClick={() => setActiveNegotiationTab('payment')}
                      >
                        Pagamento e entrega
                      </button>
                    </div>
                  )}

                  {activeNegotiationTab === 'conversation' && (
                    <>
                      <div className="negotiation-messages">
                        {selectedNegotiation.messages?.length ? selectedNegotiation.messages.map((message) => (
                          <div key={message.id} className={`negotiation-message ${message.senderId === user.id ? 'mine' : ''}`}>
                            <p>{message.content}</p>
                            <small>{new Date(message.createdAt).toLocaleString('pt-BR')}</small>
                          </div>
                        )) : <p className="negotiation-empty">Nenhuma mensagem ainda. Inicie a conversa!</p>}
                      </div>

                      {selectedNegotiation.status !== 'COMPLETED' && (
                        <form className="negotiation-form" onSubmit={sendMessage}>
                          <input value={messageDraft} onChange={(event) => setMessageDraft(event.target.value)} placeholder="Digite sua mensagem..." aria-label="Digite sua mensagem" />
                          <button className="btn btn-orange" type="submit" disabled={!messageDraft.trim()}>Enviar</button>
                        </form>
                      )}
                    </>
                  )}

                  {activeNegotiationTab === 'payment' && ['ACCEPTED', 'COMPLETED'].includes(selectedNegotiation.status) && (
                    <section className="payment-summary">
                      <h3>Resumo financeiro</h3>

                      {selectedNegotiation.listing?.dealType === 'DONATION' ? (
                        <p>Esta modalidade é gratuita. Não há cobrança de pagamento.</p>
                      ) : selectedNegotiation.listing?.dealType === 'TRADE' ? (
                        <>
                          <p>Taxa por participante: <strong>{money(3.90)}</strong></p>
                          <p>Total de taxas da troca: <strong>{money(7.80)}</strong></p>
                        </>
                      ) : (
                        <>
                          <p>
                            {selectedNegotiation.listing?.dealType === 'RENTAL' ? 'Valor do aluguel' : 'Valor do material'}:
                            <strong> {money(Number(selectedNegotiation.listing?.price || 0))}</strong>
                          </p>
                          <p>Comissão Movexa (12%): <strong>{money(Math.round(Number(selectedNegotiation.listing?.price || 0) * 100 * 0.12) / 100)}</strong></p>
                          <p>
                            Total do comprador:
                            <strong> {money((Math.round(Number(selectedNegotiation.listing?.price || 0) * 100) + Math.round(Number(selectedNegotiation.listing?.price || 0) * 100 * 0.12)) / 100)}</strong>
                          </p>
                        </>
                      )}

                      <h3>Status dos pagamentos</h3>

                      <p>
                        Comprador: <strong>
                          {selectedNegotiation.participantPayments?.find((item) => item.payerId === selectedNegotiation.buyerId)?.status === 'APPROVED'
                            ? 'Pagamento aprovado'
                            : selectedNegotiation.participantPayments?.find((item) => item.payerId === selectedNegotiation.buyerId)?.status === 'DECLINED'
                              ? 'Pagamento recusado'
                              : selectedNegotiation.listing?.dealType === 'DONATION' ? 'Sem cobrança' : 'Pendente'}
                        </strong>
                      </p>

                      {selectedNegotiation.listing?.dealType === 'TRADE' && (
                        <p>
                          Vendedor: <strong>
                            {selectedNegotiation.participantPayments?.find((item) => item.payerId === selectedNegotiation.sellerId)?.status === 'APPROVED'
                              ? 'Pagamento aprovado'
                              : selectedNegotiation.participantPayments?.find((item) => item.payerId === selectedNegotiation.sellerId)?.status === 'DECLINED'
                                ? 'Pagamento recusado'
                                : 'Pendente'}
                          </strong>
                        </p>
                      )}

                      {(selectedNegotiation.listing?.dealType === 'SALE' || selectedNegotiation.listing?.dealType === 'RENTAL') && (
                        <p>O vendedor não precisa realizar pagamento nesta modalidade.</p>
                      )}

                      {selectedNegotiation.listing?.dealType !== 'DONATION' &&
                        selectedNegotiation.status === 'ACCEPTED' &&
                        (selectedNegotiation.listing?.dealType === 'TRADE' || selectedNegotiation.buyerId === user.id) &&
                        selectedNegotiation.participantPayments?.find((item) => item.payerId === user.id)?.status !== 'APPROVED' && (
                        <div className="payment-actions">
                          <h3>Realizar pagamento</h3>
                          <label htmlFor="payment-method">Forma de pagamento</label>
                          <select
                            id="payment-method"
                            value={paymentMethod}
                            onChange={(event) => setPaymentMethod(event.target.value)}
                          >
                            <option value="PIX">PIX</option>
                            <option value="CARD">Cartão de crédito</option>
                          </select>

                          <div className="negotiation-actions">
                            <button className="btn btn-orange" type="button" onClick={() => simulatePayment('APPROVED', paymentMethod)}>
                              Confirmar pagamento
                            </button>
                            <button className="btn btn-outline" type="button" onClick={() => simulatePayment('DECLINED', paymentMethod)}>
                              Registrar pagamento não aprovado
                            </button>
                          </div>
                        </div>
                      )}

                      <small></small>

                    {(selectedNegotiation.listing?.dealType === 'DONATION' ||
                      (selectedNegotiation.listing?.dealType === 'TRADE' &&
                        [selectedNegotiation.buyerId, selectedNegotiation.sellerId].every((payerId) =>
                          selectedNegotiation.participantPayments?.some((item) =>
                            item.payerId === payerId && item.status === 'APPROVED'
                          )
                        )) ||
                      (['SALE', 'RENTAL'].includes(selectedNegotiation.listing?.dealType) &&
                        selectedNegotiation.participantPayments?.some((item) =>
                          item.payerId === selectedNegotiation.buyerId && item.status === 'APPROVED'
                        ))) && (
                    <section className="delivery-section">
                      <h3>Prazo e acompanhamento da entrega</h3>
                      <p>
                        Prazo para entrega:
                        <strong>
                          {' '}
                          {selectedNegotiation.deliveryDeadline
                            ? new Date(selectedNegotiation.deliveryDeadline).toLocaleString('pt-BR')
                            : 'A definir'}
                        </strong>
                      </p>

                      {selectedNegotiation.deliveries?.length ? (
                        <div className="delivery-list">
                          {selectedNegotiation.deliveries.map((delivery) => (
                            <article className="delivery-card" key={delivery.id}>
                              <h4>
                                {delivery.sender?.name || 'Participante'} → {delivery.receiver?.name || 'Participante'}
                              </h4>

                              <p>
                                Situação: <strong>
                                  {delivery.confirmedAt
                                    ? 'Recebimento confirmado'
                                    : delivery.proofImageUrl
                                      ? 'Aguardando confirmação'
                                      : 'Aguardando comprovante'}
                                </strong>
                              </p>

                              {delivery.sentAt && (
                                <p>Comprovante enviado em: {new Date(delivery.sentAt).toLocaleString('pt-BR')}</p>
                              )}

                              {delivery.proofImageUrl && (
                                <div className="delivery-proof">
                                  <img
                                    src={imageSrc(delivery.proofImageUrl)}
                                    alt="Foto de comprovação da entrega"
                                  />
                                </div>
                              )}

                              {selectedNegotiation.status === 'ACCEPTED' &&
                                delivery.senderId === user.id &&
                                !delivery.proofImageUrl && (
                                  <div className="delivery-upload">
                                    <label htmlFor={`delivery-proof-${delivery.id}`}>
                                      Enviar foto de comprovação
                                    </label>
                                    <input
                                      id={`delivery-proof-${delivery.id}`}
                                      type="file"
                                      accept="image/png,image/jpeg,image/webp"
                                      onChange={(event) => {
                                        const file = event.target.files?.[0];
                                        if (file) uploadDeliveryProof(delivery.id, file);
                                        event.target.value = '';
                                      }}
                                    />
                                    <small>PNG, JPG ou WEBP. Limite de 5 MB.</small>
                                  </div>
                                )}

                              {selectedNegotiation.status === 'ACCEPTED' &&
                                delivery.receiverId === user.id &&
                                delivery.proofImageUrl &&
                                !delivery.confirmedAt && (
                                  <button
                                    type="button"
                                    onClick={() => confirmDelivery(delivery.id)}
                                  >
                                    Confirmar recebimento
                                  </button>
                                )}

                              {delivery.confirmedAt && (
                                <p className="delivery-confirmed">
                                  Confirmado em {new Date(delivery.confirmedAt).toLocaleString('pt-BR')}
                                </p>
                              )}
                            </article>
                          ))}
                        </div>
                      ) : (
                        <p>As etapas de entrega ainda não foram registradas.</p>
                      )}

                      <small>
                        A negociação só será concluída quando todas as entregas e confirmações obrigatórias forem realizadas.
                      </small>
                    </section>
                    )}
                    </section>
                  )}
                </>
              ) : (
                <div className="negotiation-empty">
                  <h2>Suas conversas aparecem aqui</h2>
                  <p>Selecione uma negociação ao lado para visualizar as mensagens.</p>
                </div>
              )}
            </section>
          </div>
        </section>
      </main>
    ) : null}

    {activeView === 'my-listings' && user && (
      <main className="my-listings-page">
        <section className="my-listings-container">
          <div className="my-listings-heading">
            <div>
              <span className="eyebrow">SEUS ANÚNCIOS</span>
              <h1>Meus <em>produtos</em></h1>
              <p>Acompanhe a situação dos materiais que você anunciou na Movexa.</p>
            </div>
            <button className="btn btn-outline" onClick={() => setActiveView('home')}>
              Voltar aos anúncios
            </button>
          </div>

          <div className="my-listings-filters">
            {[
              { value: 'ALL', label: 'Todos' },
              { value: 'PENDING', label: 'Pendentes' },
              { value: 'ACTIVE', label: 'Aprovados' },
              { value: 'REJECTED', label: 'Rejeitados' }
            ].map((filter) => (
              <button
                key={filter.value}
                className={myListingsFilter === filter.value ? 'category-chip selected' : 'category-chip'}
                onClick={() => setMyListingsFilter(filter.value)}
              >
                {filter.label}
              </button>
            ))}
          </div>

          {loadingMyListings ? (
            <p className="status-message">Carregando seus produtos...</p>
          ) : (
            <div className="my-listings-grid">
              {myListings
                .filter((item) => myListingsFilter === 'ALL' || item.status === myListingsFilter)
                .map((item) => (
                  <article className="my-listing-card" key={item.id}>
                    <div className="my-listing-image">
                      <img
                        src={imageSrc(item.imageUrl) || 'https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?auto=format&fit=crop&w=800&q=80'}
                        alt={item.title}
                      />
                    </div>
                    <div className="my-listing-info">
                      <span className="product-category">{item.category}</span>
                      <h2>{item.title}</h2>
                      <p>{dealLabels[item.dealType] || item.dealType}</p>
                      <strong>{money(item.price) || 'A combinar'}</strong>
                      <span className="my-listing-date">
                        Enviado em {item.createdAt ? new Date(item.createdAt).toLocaleDateString('pt-BR') : 'Data não disponível'}
                      </span>
                      <span className={`listing-status status-${String(item.status || '').toLowerCase()}`}>
                        {item.status === 'PENDING' ? 'Pendente de aprovação' :
                         item.status === 'ACTIVE' ? 'Aprovado e publicado' :
                         item.status === 'REJECTED' ? 'Rejeitado' : item.status}
                      </span>
                      {item.status === 'REJECTED' && (
                        <div className="rejection-reason">
                          <strong>Motivo da rejeição</strong>
                          <p>{item.rejectionReason || 'Nenhuma justificativa informada.'}</p>
                        </div>
                      )}
                    </div>
                  </article>
                ))}
              {!myListings.length && (
                <div className="empty-state">
                  <BookOpen size={32} />
                  <h3>Você ainda não anunciou produtos</h3>
                  <p>Seus anúncios aparecerão aqui depois que você publicar um material.</p>
                </div>
              )}
              {myListings.length > 0 && !myListings.some((item) => myListingsFilter === 'ALL' || item.status === myListingsFilter) && (
                <div className="empty-state">
                  <BookOpen size={32} />
                  <h3>Nenhum produto nesta categoria</h3>
                  <p>Experimente selecionar outro filtro.</p>
                </div>
              )}
            </div>
          )}
        </section>
      </main>
    )}

    {activeView === 'profile' && user && (
      <main className="profile-page">
        <section className="profile-container">
          <span className="eyebrow">SUA CONTA NA MOVEXA</span>
          <h1>Meu perfil</h1>
          <p className="profile-description">
            Mantenha seus dados acadêmicos e pessoais atualizados.
          </p>

          <form className="profile-form" onSubmit={saveProfile}>
            <label>
              Nome completo
              <input
                type="text"
                required
                minLength={2}
                maxLength={100}
                value={profileForm.name}
                onChange={(event) => setProfileForm({ ...profileForm, name: event.target.value })}
              />
            </label>

            <label>
              E-mail institucional
              <input type="email" value={user.email || ''} readOnly disabled />
              <small>O e-mail da conta não pode ser alterado por aqui.</small>
            </label>

            <label>
              Instituição de ensino
              <input
                type="text"
                required
                minLength={2}
                maxLength={150}
                value={profileForm.institution}
                onChange={(event) => setProfileForm({ ...profileForm, institution: event.target.value })}
              />
            </label>

            <label>
              Curso
              <input
                type="text"
                required
                minLength={2}
                maxLength={120}
                value={profileForm.course}
                onChange={(event) => setProfileForm({ ...profileForm, course: event.target.value })}
              />
            </label>

            <label>
              Cidade e estado
              <input
                type="text"
                required
                minLength={2}
                maxLength={120}
                placeholder="Ex.: Fortaleza, CE"
                value={profileForm.location}
                onChange={(event) => setProfileForm({ ...profileForm, location: event.target.value })}
              />
            </label>

            <div className="profile-actions">
              <button className="btn btn-orange" type="submit" disabled={savingProfile}>
                {savingProfile ? 'Salvando...' : 'Salvar alterações'}
              </button>
              <button className="btn btn-outline" type="button" onClick={() => setActiveView('home')}>
                Voltar aos anúncios
              </button>
            </div>
          </form>
        </section>
      </main>
    )}
    {activeView === 'admin' && (
      <main className="admin-page">
        <section className="admin-container">
          <div className="admin-heading">
            <div>
              <span className="eyebrow">GESTÃO MOVEXA</span>
              <h1>Painel <em>administrativo</em></h1>
              <p>Analise os anúncios enviados pelos estudantes antes de publicá-los.</p>
            </div>
            <button className="btn btn-outline" onClick={() => setActiveView('home')}>Voltar aos anúncios</button>
          </div>

          {user?.role !== 'ADMIN' ? (
            <div className="empty-state">
              <ShieldCheck size={32} />
              <h3>Acesso não autorizado</h3>
              <p>Esta área é exclusiva da equipe administrativa.</p>
            </div>
          ) : (
            <>
              <div className="admin-section-heading">
                <div>
                  <h2>Anúncios aguardando aprovação</h2>
                  <p>{pendingListings.length} anúncio(s) pendente(s)</p>
                </div>
              </div>

              {loadingPending ? (
                <div className="empty-state"><p>Carregando anúncios pendentes...</p></div>
              ) : pendingListings.length === 0 ? (
                <div className="empty-state">
                  <ShieldCheck size={32} />
                  <h3>Nenhum anúncio aguardando aprovação</h3>
                  <p>Quando um estudante enviar um anúncio, ele aparecerá aqui.</p>
                </div>
              ) : (
                <div className="admin-listings">
                  {pendingListings.map((item) => (
                    <article className="admin-listing-card" key={item.id}>
                      {item.imageUrl ? (
                        <img className="admin-listing-image" src={imageSrc(item.imageUrl)} alt={item.title} />
                      ) : (
                        <div className="admin-listing-placeholder"><BookOpen size={32} /><span>Sem foto</span></div>
                      )}
                      <div className="admin-listing-info">
                        <span className="product-category">{item.category} · {dealLabels[item.dealType] || item.dealType}</span>
                        <h3>{item.title}</h3>
                        <p>{item.description}</p>
                        <div className="admin-listing-details">
                          <span><strong>Anunciante:</strong> {item.owner?.name || 'Não informado'}</span>
                          <span><strong>Curso:</strong> {item.owner?.course || 'Não informado'}</span>
                          <span><strong>Instituição:</strong> {item.owner?.institution || 'Não informada'}</span>
                          <span><strong>Local:</strong> {item.location}</span>
                          <span><strong>Valor:</strong> {money(item.price) || 'A combinar'}</span>
                        </div>
                        <div className="admin-listing-actions">
                          <button className="btn btn-orange" disabled={moderatingListing === item.id} onClick={() => moderateListing(item.id, 'ACTIVE')}>
                            {moderatingListing === item.id ? 'Aguarde...' : 'Aprovar anúncio'}
                          </button>
                          <button className="btn btn-outline" disabled={moderatingListing === item.id} onClick={() => {
                              setRejectionListingId(item.id);
                              setRejectionReason('');
                            }}>Rejeitar</button>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              )}
            <div className="admin-section-heading" style={{ marginTop: '48px' }}>
              <div>
                <h2>Pagamentos aguardando análise</h2>
                <p>{pendingPayments.length} pagamento(s) pendente(s)</p>
              </div>
            </div>

            {loadingPayments ? (
              <div className="empty-state">
                <p>Carregando pagamentos pendentes...</p>
              </div>
            ) : pendingPayments.length === 0 ? (
              <div className="empty-state">
                <ShieldCheck size={32} />
                <h3>Nenhum pagamento aguardando análise</h3>
                <p>Quando um estudante informar um pagamento, ele aparecerá aqui.</p>
              </div>
            ) : (
              <div className="admin-listings">
                {pendingPayments.map((item) => {
                  const negotiation = item.negotiation;
                  const listing = negotiation?.listing;

                  return (
                    <article className="admin-payment-card" key={item.id}>
                      <div className="admin-listing-info">
                        <span className="product-category">
                          {dealLabels[listing?.dealType] || listing?.dealType || 'Negociação'}
                        </span>
                        <h3>{listing?.title || 'Produto não informado'}</h3>

                        <div className="admin-listing-details">
                          <span><strong>Participante:</strong> {item.payer?.name || 'Não informado'}</span>
                          <span><strong>E-mail:</strong> {item.payer?.email || 'Não informado'}</span>
                          <span><strong>Comprador:</strong> {negotiation?.buyer?.name || 'Não informado'}</span>
                          <span><strong>Vendedor:</strong> {negotiation?.seller?.name || 'Não informado'}</span>
                          <span><strong>Valor informado:</strong> {money(item.amount)}</span>
                          <span><strong>Forma de pagamento:</strong> {item.method === 'PIX' ? 'PIX' : 'Cartão'}</span>
                          <span><strong>Data do registro:</strong> {item.reportedAt ? new Date(item.reportedAt).toLocaleString('pt-BR') : 'Não informada'}</span>
                        </div>

                        <div className="admin-listing-actions">
                          <button
                            className="btn btn-orange"
                            disabled={reviewingPayment === item.id}
                            onClick={() => decideParticipantPayment(item.id, 'APPROVED')}
                          >
                            {reviewingPayment === item.id ? 'Aguarde...' : 'Aprovar pagamento'}
                          </button>
                          <button
                            className="btn btn-outline"
                            disabled={reviewingPayment === item.id}
                            onClick={() => decideParticipantPayment(item.id, 'DECLINED')}
                          >
                            Recusar pagamento
                          </button>
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>
            )}
            </>
          )}
        </section>
      </main>
    )}
    {rejectionListingId && (
      <div className="modal-backdrop" onClick={(event) => {
        if (event.target === event.currentTarget && !moderatingListing) {
          setRejectionListingId('');
          setRejectionReason('');
        }
      }}>
        <section className="details-modal" role="dialog" aria-modal="true" aria-labelledby="rejection-title">
          <button
            className="modal-close"
            onClick={() => {
              setRejectionListingId('');
              setRejectionReason('');
            }}
            disabled={!!moderatingListing}
            aria-label="Fechar"
          >
            <X />
          </button>

          <span className="eyebrow">MODERAÇÃO DE ANÚNCIO</span>
          <h2 id="rejection-title">Motivo da rejeição</h2>
          <p>Explique ao estudante por que o anúncio não foi aprovado.</p>

          <form onSubmit={(event) => {
            event.preventDefault();
            moderateListing(rejectionListingId, 'REJECTED', rejectionReason.trim());
          }}>
            <label>
              Justificativa *
              <textarea
                value={rejectionReason}
                onChange={(event) => setRejectionReason(event.target.value)}
                minLength={5}
                maxLength={500}
                rows={5}
                required
                placeholder="Descreva o motivo da rejeição..."
              />
            </label>
            <small>{rejectionReason.length}/500 caracteres</small>

            <div className="admin-listing-actions">
              <button
                type="button"
                className="btn btn-outline"
                disabled={!!moderatingListing}
                onClick={() => {
                  setRejectionListingId('');
                  setRejectionReason('');
                }}
              >
                Cancelar
              </button>
              <button
                type="submit"
                className="btn btn-orange"
                disabled={!!moderatingListing || rejectionReason.trim().length < 5}
              >
                {moderatingListing ? 'Aguarde...' : 'Confirmar rejeição'}
              </button>
            </div>
          </form>
        </section>
      </div>
    )}
    {notice && <div className="toast" role="status">{notice}<button onClick={() => setNotice('')} aria-label="Fechar aviso"><X size={15} /></button></div>}
    {modal === 'details' && selectedListing && (
      <div className="modal-backdrop" onClick={(event) => event.target === event.currentTarget && setModal('')}>
        <section className="details-modal" role="dialog" aria-modal="true">
          <button className="modal-close" onClick={() => setModal('')} aria-label="Fechar">
            <X />
          </button>

          <span className="eyebrow">DETALHES DO MATERIAL</span>

          <div className="details-content">
            <img
              className="details-image"
              src={imageSrc(selectedListing.imageUrl) || 'https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?auto=format&fit=crop&w=800&q=80'}
              alt={selectedListing.title}
            />

            <div className="details-info">
              <span className="product-category">{selectedListing.category}</span>
              <h2>{selectedListing.title}</h2>

              <p className="details-description">
                {selectedListing.description || 'O anunciante não informou uma descrição para este material.'}
              </p>

              <p className="details-description">
                Conservação: {conditionLabels[selectedListing.condition] || 'Não informada'}
              </p>

              <p className="details-description">
                Modalidade: {dealLabels[selectedListing.dealType] || selectedListing.dealType}
              </p>

              <p className="details-description">
                Localização: {selectedListing.location || 'Não informada'}
              </p>

              <div className="details-price">
                {money(selectedListing.price) || 'A combinar'}
                {selectedListing.dealType === 'RENTAL' && selectedListing.price != null && <small> / período</small>}
              </div>

              <div className="details-seller">
                <strong>Vendedor:</strong> {selectedListing.owner?.name || 'Anunciante'}
                <br />
                <strong>Curso:</strong> {selectedListing.owner?.course || 'Não informado'}
                <br />
                <strong>Instituição:</strong> {selectedListing.owner?.institution || 'Não informada'}
              </div>

              <div className="details-actions">
                <button
                  className="btn btn-orange"
                  onClick={startNegotiation}
                >
                  Iniciar negociação <ArrowRight size={16} />
                </button>
              </div>
            </div>
          </div>
        </section>
      </div>
    )}
    {modal && modal !== 'details' && <div className="modal-backdrop" onClick={(event) => event.target === event.currentTarget && setModal('')}><section className="modal" role="dialog" aria-modal="true"><button className="modal-close" onClick={() => setModal('')} aria-label="Fechar"><X /></button><span className="eyebrow">{modal === 'listing' ? 'PASSE ADIANTE' : 'BEM-VINDO À MOVEXA'}</span><h2>{modal === 'listing' ? 'Publique seu anúncio.' : modal === 'login' ? 'Que bom ter você de volta.' : 'Seu lugar também é aqui.'}</h2>
      {modal === 'listing' ? <form onSubmit={createListing} className="form-grid"><label>Título<input name="title" minLength="3" required placeholder="Ex.: Livro de Cálculo" /></label><label>Categoria<input name="category" required placeholder="Ex.: Livros" /></label><label className="full">Descrição<textarea name="description" required minLength="10" placeholder="Conte sobre o material..." /></label><label>Modalidade<select name="dealType"><option value="SALE">Venda</option><option value="TRADE">Troca</option><option value="DONATION">Doação</option><option value="RENTAL">Aluguel</option></select></label><label>Preço (R$)<input name="price" type="number" min="0" step="0.01" placeholder="Deixe em branco se não se aplica" /></label><label>Condição<select name="condition"><option value="GOOD">Bom estado</option><option value="NEW">Novo</option><option value="LIKE_NEW">Quase novo</option><option value="FAIR">Usado</option></select></label><label>Localização<input name="location" required defaultValue={user?.location || ''} placeholder="Cidade, UF" /></label><label className="full">Foto do material (PNG, JPG ou WEBP)<input name="image" type="file" accept="image/png,image/jpeg,image/webp" onChange={(event) => { const file = event.target.files?.[0]; setImagePreview(file ? URL.createObjectURL(file) : ""); }} /><small>Selecione uma imagem de até 5 MB.</small></label>{imagePreview && <div className="image-preview full"><img src={imagePreview} alt="Prévia da imagem do anúncio" /></div>}<button className="btn btn-orange full" type="submit">Enviar para aprovação <ArrowRight size={16} /></button></form> : <form onSubmit={submitAuth} className="form-grid">{modal === 'register' && <><label className="full">Nome completo<input name="name" minLength="2" required autoComplete="name" /></label><label className="full">Curso<input name="course" required /></label><label className="full">Cidade, estado<input name="location" required placeholder="Ex.: São Paulo, SP" /></label></>}<label className="full">E-mail<input name="email" type="email" required autoComplete="email" />{modal === 'register' && <small>Use seu e-mail institucional: IFCE, Unifor, Unichristus, UFC ou UECE.</small>}</label><label className="full">Senha<input name="password" type="password" minLength="10" required autoComplete={modal === 'login' ? 'current-password' : 'new-password'} />{modal === 'register' && <small>Mínimo de 10 caracteres.</small>}</label><button className="btn btn-orange full" type="submit">{modal === 'login' ? 'Entrar na minha conta' : 'Criar minha conta'} <ArrowRight size={16} /></button><p className="form-switch full">{modal === 'login' ? 'Ainda não tem conta?' : 'Já faz parte da Movexa?'} <button type="button" onClick={() => setModal(modal === 'login' ? 'register' : 'login')}>{modal === 'login' ? 'Cadastre-se' : 'Entrar'}</button></p></form>}
      <p className="privacy-note">Ao continuar, você concorda com nossos termos de uso e política de privacidade.</p></section></div>}
  </>;
}























