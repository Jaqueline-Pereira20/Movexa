# Conexão com o PostgreSQL
DATABASE_URL="postgresql://movexa:movexa@localhost:5432/movexa?schema=public"

# Segredo do JWT: gere um valor aleatório com pelo menos 32 caracteres
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

PORT=4000

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Defina como 1 se a API estiver atrás de um proxy reverso (Nginx, Render, etc.)
# TRUST_PROXY=1
